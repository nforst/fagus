{
    "name": "nforst/fagus",
    "description": "HTML and CSS to PDF for PHP and Laravel, without a browser: renders like Chrome prints, with PDF/A, PDF/UA and ZUGFeRD/Factur-X.",
    "keywords": [
        "php",
        "laravel",
        "blade",
        "pdf",
        "html",
        "css",
        "html-to-pdf",
        "paged-media",
        "pdfa",
        "pdf-ua",
        "factur-x",
        "zugferd"
    ],
    "type": "composer-plugin",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://fagus.niklasforst.de",
    "support": {
        "issues": "https://github.com/nforst/fagus/issues",
        "source": "https://github.com/nforst/fagus"
    },
    "authors": [
        {
            "name": "Niklas Forst",
            "homepage": "https://github.com/nforst"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "psr/simple-cache": "^3.0",
        "spatie/laravel-pdf": "^2.0"
    },
    "suggest": {
        "laravel/framework": "PDFs from Blade views, with a facade, responses and filesystem disks (Laravel 13)",
        "psr/simple-cache": "Keeps what a resolver fetched in a PSR-16 cache, with cache() (^3.0)",
        "spatie/laravel-pdf": "Fagus as the `fagus` driver of laravel-pdf (^2.0)"
    },
    "conflict": {
        "laravel/framework": "<13.0"
    },
    "autoload": {
        "psr-4": {
            "Fagus\\": "php/fagus/src/",
            "Fagus\\Laravel\\": "php/laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fagus\\Tests\\": "php/fagus/tests/",
            "Fagus\\Laravel\\Tests\\": "php/laravel/tests/"
        }
    },
    "bin": [
        "php/fagus/bin/fagus-install"
    ],
    "extra": {
        "class": "Fagus\\Composer\\Plugin",
        "laravel": {
            "providers": [
                "Fagus\\Laravel\\FagusServiceProvider"
            ],
            "aliases": {
                "Fagus": "Fagus\\Laravel\\Facades\\Fagus"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
